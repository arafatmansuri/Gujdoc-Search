# =========================================================
# Application
# =========================================================
APP_NAME="Gujarati Government Document Digitisation and Search"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Use a long, random secret in deployed environments
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# =========================================================
# Managed PostgreSQL + pgvector
# =========================================================
# Use the connection string supplied by your managed DB provider.
# Ensure pgvector is installed/enabled on the database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Gemini embedding dimensions must match the pgvector column dimension.
EMBEDDING_DIMENSIONS=3072


# =========================================================
# Managed Redis
# =========================================================
# Example formats vary by provider. Use the provider's TLS URL
# when required, such as rediss://...
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT


# =========================================================
# Celery / Background Processing
# =========================================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}


# =========================================================
# Google Gemini
# =========================================================
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash


# =========================================================
# Azure Blob Storage
# =========================================================
# Keep credentials backend-only. Never expose these to frontend code.
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER=government-documents

# For local development using account key authentication:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# SAS upload URL expiry, in minutes
AZURE_SAS_UPLOAD_EXPIRY_MINUTES=10

# Maximum upload size in bytes (example: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Azure endpoint, usually the default public cloud endpoint
AZURE_STORAGE_BLOB_ENDPOINT=https://your-storage-account-name.blob.core.windows.net


# =========================================================
# OCR / Tesseract
# =========================================================
Windows example:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Linux/macOS usually:
# TESSERACT_CMD=/usr/bin/tesseract

# Gujarati + English OCR
OCR_LANGUAGES=guj+eng

# Optional path to tessdata directory
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata


# =========================================================
# Document Processing
# =========================================================
# Chunking defaults; tune based on retrieval evaluation
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Temporary processing directory
TEMP_DIR=./tmp


# =========================================================
# Logging
# =========================================================
LOG_LEVEL=INFO